function ingestFiles
{
    SOURCE_DIR="/mft/NASH5"
    WORK_DIR="${BASE_DIR}/work_dir"

    log "Starting file ingestion from ${SOURCE_DIR}"

    find "${SOURCE_DIR}" -type f -name "*.zip" | while IFS= read -r ZIP_FILE
    do
        log "Found ZIP file: ${ZIP_FILE}"

        unzip -o "${ZIP_FILE}" -d "${WORK_DIR}" >> "${LOG_FILE}" 2>&1
        UNZIP_RC=$?

        if [ ${UNZIP_RC} -eq 0 ]; then
            log "Successfully unzipped: ${ZIP_FILE}"

            rm -f "${ZIP_FILE}"
            DELETE_RC=$?

            if [ ${DELETE_RC} -eq 0 ]; then
                log "Successfully deleted source file: ${ZIP_FILE}"
            else
                log "ERROR: File was unzipped successfully but could not be deleted: ${ZIP_FILE}"
            fi
        else
            log "ERROR: Failed to unzip: ${ZIP_FILE}"
            log "ERROR: Unzip return code: ${UNZIP_RC}"
            log "Source file will NOT be deleted: ${ZIP_FILE}"
        fi

    done

    log "File ingestion completed"
}
