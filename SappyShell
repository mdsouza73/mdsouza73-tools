function regionSplitting
{
    WORK_FILE=$(find "${WORK_DIR}" -mindepth 1 -maxdepth 1 -type f | head -1)

    if [ -z "${WORK_FILE}" ]; then
        log "ERROR: No file found in work directory: ${WORK_DIR}"
        return 1
    fi

    FILE_NAME=$(basename "${WORK_FILE}")

    log "Starting Region Splitting: ${FILE_NAME}"

    NA_DIR="${SPLIT_DIR}/1"
    ROW_DIR="${SPLIT_DIR}/2"
    PEP_DIR="${SPLIT_DIR}/3"

    mkdir -p "${NA_DIR}"
    mkdir -p "${ROW_DIR}"
    mkdir -p "${PEP_DIR}"

    # ------------------------------------------------------------
    # PEP FILE
    # PEP is identified only by the filename.
    # Ignore the RecordCount header.
    # All data records go to Region 3.
    # ------------------------------------------------------------

    if [[ "${FILE_NAME}" == *PEP* ]]; then

        PEP_FILE="${PEP_DIR}/PEP_${FILE_NAME}"

        log "PEP file identified: ${FILE_NAME}"
        log "Creating PEP file: ${PEP_FILE}"

        tail -n +2 "${WORK_FILE}" > "${PEP_FILE}"

        if [ $? -ne 0 ]; then
            log "ERROR: Failed to create PEP file: ${PEP_FILE}"
            return 1
        fi

        log "PEP splitting completed successfully"

    else

        # --------------------------------------------------------
        # NON-PEP FILE
        #
        # Ignore RecordCount header.
        #
        # First two characters of Column 1 determine the output
        # filename.
        #
        # US / CA / BM -> Region 1 (NA)
        # Everything else -> Region 2 (ROW)
        # --------------------------------------------------------

        log "Non-PEP file identified: ${FILE_NAME}"
        log "Starting country/region splitting"

        awk -F'|' \
            -v na_dir="${NA_DIR}" \
            -v row_dir="${ROW_DIR}" \
            -v file_name="${FILE_NAME}" '

            NR == 1 {
                next
            }

            {
                country = substr($1, 1, 2)

                if (country == "US" ||
                    country == "CA" ||
                    country == "BM")
                {
                    output_file = na_dir "/" country "_" file_name
                }
                else
                {
                    output_file = row_dir "/" country "_" file_name
                }

                print > output_file
            }

        ' "${WORK_FILE}"

        AWK_RC=$?

        if [ ${AWK_RC} -ne 0 ]; then
            log "ERROR: Region splitting failed for: ${FILE_NAME}"
            log "ERROR: AWK return code: ${AWK_RC}"
            return 1
        fi

        log "Country/Region splitting completed successfully"

    fi

    log "Region Splitting completed successfully: ${FILE_NAME}"

    return 0
}
