function ingestCSVFiles
{
    log "Starting CSV file ingestion from ${SOURCE_DIR}"

    find "${SOURCE_DIR}" -type f -name "*.csv" | while IFS= read -r CSV_FILE
    do
        log "Found CSV file: ${CSV_FILE}"

        FILE_NAME=$(basename "${CSV_FILE}")

        cp "${CSV_FILE}" "${WORK_DIR}/${FILE_NAME}" >> "${LOG_FILE}" 2>&1
        CP_RC=$?

        if [ ${CP_RC} -eq 0 ]; then
            log "Successfully copied CSV file: ${CSV_FILE}"
        else
            log "ERROR: Failed to copy CSV file: ${CSV_FILE}"
            log "ERROR: Copy return code: ${CP_RC}"
            return 1
        fi
    done

    log "CSV file ingestion completed"

    return 0
}
