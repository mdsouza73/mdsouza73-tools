#!/bin/ksh

# ------------------------------------------------------------
# Compliance Link 5.0 File Preprocessor
# ------------------------------------------------------------

BASE_DIR="/home/cb7510764/ComplianceLink_5.0/scripts/ComplianceLink_5.0"

SOURCE_DIR="/mft/source/sftpcrsp"
WORK_DIR="${BASE_DIR}/work_dir"
SPLIT_DIR="${BASE_DIR}/splitting"
LOG_DIR="${BASE_DIR}/logs"

# ------------------------------------------------------------
# Create directories
# ------------------------------------------------------------

mkdir -p "${WORK_DIR}"
mkdir -p "${SPLIT_DIR}"
mkdir -p "${LOG_DIR}"

# ------------------------------------------------------------
# Create today's log file
# Format:
# ComplianceLink_PreProcessor_yyyymmdd.log
# ------------------------------------------------------------

LOG_DATE=$(date '+%Y%m%d')
LOG_FILE="${LOG_DIR}/ComplianceLink_PreProcessor_${LOG_DATE}.log"

# ------------------------------------------------------------
# Logging function
# Format:
# hh:mm:ss - Log message
# ------------------------------------------------------------

function log
{
    echo "$(date '+%H:%M:%S') - $1" >> "${LOG_FILE}"
}

# ------------------------------------------------------------
# Start
# ------------------------------------------------------------

log "Starting Compliance Link 5.0 PreProcessor"
log "Source Directory: ${SOURCE_DIR}"
log "Working Directory: ${WORK_DIR}"
log "Splitting Directory: ${SPLIT_DIR}"
log "Log File: ${LOG_FILE}"
