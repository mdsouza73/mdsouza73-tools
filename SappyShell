function regionSplitting
{
    WORK_FILE=$(find "${WORK_DIR}" -mindepth 1 -maxdepth 1 -type f | head -1)

    if [ -z "${WORK_FILE}" ]; then
        log "ERROR: No file found in work directory: ${WORK_DIR}"
        return 1
    fi

    FILE_NAME=$(basename "${WORK_FILE}")

    log "Starting Region Splitting for: ${FILE_NAME}"

    NA_DIR="${SPLIT_DIR}/1"
    ROW_DIR="${SPLIT_DIR}/2"
    PEP_DIR="${SPLIT_DIR}/3"

    mkdir -p "${NA_DIR}"
    mkdir -p "${ROW_DIR}"
    mkdir -p "${PEP_DIR}"

    NA_FILE="${NA_DIR}/${FILE_NAME}"
    ROW_FILE="${ROW_DIR}/${FILE_NAME}"
    PEP_FILE="${PEP_DIR}/${FILE_NAME}"

    # ------------------------------------------------------------
    # PEP File
    # PEP is identified only by the filename.
    # Ignore the RecordCount header and send all data to folder 3.
    # ------------------------------------------------------------

    case "${FILE_NAME}" in

        *PEP*)
            log "PEP file identified: ${FILE_NAME}"
            log "Sending all data records to Region 3"

            tail -n +2 "${WORK_FILE}" > "${PEP_FILE}"

            if [ $? -ne 0 ]; then
                log "ERROR: Failed to create PEP split file: ${PEP_FILE}"
                return 1
            fi

            log "PEP Region Splitting successful: ${PEP_FILE}"
            ;;

        *)
            # ----------------------------------------------------
            # Non-PEP File
            # US / CA / BM -> NA -> folder 1
            # Everything else -> ROW -> folder 2
            # ----------------------------------------------------

            log "Non-PEP file identified: ${FILE_NAME}"
            log "Performing NA / ROW region splitting"

            awk -F'|' '
            NR == 1 {
                next
            }

            {
                country = substr($1, 1, 2)

                if (country == "US" ||
                    country == "CA" ||
                    country == "BM")
                {
                    print > na_file
                }
                else
                {
                    print > row_file
                }
            }
            ' na_file="${NA_FILE}" row_file="${ROW_FILE}" "${WORK_FILE}"

            AWK_RC=$?

            if [ ${AWK_RC} -ne 0 ]; then
                log "ERROR: Region splitting failed for: ${FILE_NAME}"
                log "ERROR: AWK return code: ${AWK_RC}"
                return 1
            fi

            # Remove empty output files
            if [ -f "${NA_FILE}" ] && [ ! -s "${NA_FILE}" ]; then
                rm -f "${NA_FILE}"
            fi

            if [ -f "${ROW_FILE}" ] && [ ! -s "${ROW_FILE}" ]; then
                rm -f "${ROW_FILE}"
            fi

            if [ -f "${NA_FILE}" ]; then
                NA_COUNT=$(wc -l < "${NA_FILE}" | awk '{print $1}')
                log "NA Region (1): ${NA_COUNT} records"
            else
                log "NA Region (1): No records"
            fi

            if [ -f "${ROW_FILE}" ]; then
                ROW_COUNT=$(wc -l < "${ROW_FILE}" | awk '{print $1}')
                log "ROW Region (2): ${ROW_COUNT} records"
            else
                log "ROW Region (2): No records"
            fi

            log "NA / ROW Region Splitting successful: ${FILE_NAME}"
            ;;
    esac

    log "Region Splitting completed successfully: ${FILE_NAME}"

    return 0
}
