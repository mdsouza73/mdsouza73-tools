# The tool is to monitor a folder for the Application Source/Staging using a Task Scheduler on a Windows OS with Powershell

# ============================================================
# APM Staging File Monitor
# ============================================================

# -------- Configuration --------

$MonitorFolder = "C:\Stating"
$OutputFile    = "C:\FileMonitor.txt"


# -------- Function to scan the folder --------

function Scan-Folder {
    param (
        [string]$Folder
    )

    # Find all files in the folder and its subfolders
    $Files = Get-ChildItem -Path $Folder -File -Recurse -ErrorAction SilentlyContinue

    foreach ($File in $Files) {

        # Get detection date and time
        $DetectionDate = Get-Date -Format "dd-MMM-yyyy"
        $DetectionTime = Get-Date -Format "HH:mm:ss"

        # Get last modified date/time
        $LastModified = $File.LastWriteTime.ToString("dd-MMM-yyyy HH:mm:ss")

        # Return the details
        [PSCustomObject]@{
            DetectionDate = $DetectionDate
            DetectionTime = $DetectionTime
            Filename      = $File.Name
            LastModified  = $LastModified
            Path          = $File.DirectoryName
        }
    }
}


# -------- Read existing output --------

$ExistingEntries = @()

if (Test-Path $OutputFile) {

    $ExistingEntries = Get-Content $OutputFile
}


# -------- Scan the folder --------

$FileDetails = Scan-Folder -Folder $MonitorFolder


# -------- Process the results --------

foreach ($File in $FileDetails) {

    # Create the unique identifier for this file/version
    $UniqueEntry = "$($File.Filename) | $($File.LastModified) | $($File.Path)"

    # Check whether this exact entry already exists
    $AlreadyExists = $ExistingEntries | Where-Object {
        $_ -like "*$UniqueEntry"
    }

    # If it doesn't exist, add it to the output file
    if (-not $AlreadyExists) {

        $OutputLine = "$($File.DetectionDate) | $($File.DetectionTime) | $($File.Filename) | $($File.LastModified) | $($File.Path)"

        Add-Content -Path $OutputFile -Value $OutputLine
    }
}
